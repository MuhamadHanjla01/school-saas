generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── School (Tenant Root) ──────────────────────────────────────────────────────

model School {
  id        String   @id @default(uuid())
  institutionType String @default("School")
  name      String
  slug      String   @unique   // URL-friendly identifier e.g. "inilabs-academy"
  domain    String?  @unique   // Custom domain e.g. "school.inilabs.com"
  logo      String?            // URL to logo
  address   String?
  phone     String?
  email     String?
  plan      String   @default("Free")   // Free, Pro, Enterprise
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeAccountId       String? @unique
  paymentCurrency       String  @default("usd")
  paymentCountry        String?
  stripeChargesEnabled  Boolean @default(false)
  stripePayoutsEnabled  Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)

  users              User[]
  students           Student[]
  teachers           Teacher[]
  staff              Staff[]
  parents            Parent[]
  classes            Class[]
  subjects           Subject[]
  timetableSlots     Timetable[]
  attendance         Attendance[]
  teacherAttendance  TeacherAttendance[]
  assignments        Assignment[]
  exams              Exam[]
  fees               Fee[]
  feePayments        FeePayment[]
  notices            Notice[]
  events             Event[]
  messages           Message[]
  salaries           Salary[]
  auditLogs          AuditLog[]
  documents          Document[]
  notifications      Notification[]
  books              Book[]
  labItems           LabItem[]
  healthRecords      HealthRecord[]
  transportRoutes    TransportRoute[]
  certificates       Certificate[]
  settings           SchoolSettings?
  subscription       Subscription?
  supportTickets     SupportTicket[]
  campuses Campus[]
  academicTerms AcademicTerm[]
  hostelRooms HostelRoom[]
}

// ─── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("Student")
  name         String?
  phone        String?
  avatar       String?
  refreshToken String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // Optional 1:1 links to profile
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id])
  teacherId String?  @unique
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications    Notification[]
  passwordResetTokens PasswordResetToken[]

  @@index([schoolId])
}

// ─── Student ───────────────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(uuid())
  studentId    String
  name         String
  guardianName String
  phone        String
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // NEW ONBOARDING FIELDS - Personal Details
  middleName    String?
  lastName      String?
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  nationality   String?
  studentEmail  String?

  // NEW ONBOARDING FIELDS - Guardian
  motherName         String?
  parentRelationship String?
  parentEmail        String?
  emergencyContact   String?

  // NEW ONBOARDING FIELDS - Address
  country      String?
  state        String?
  city         String?
  municipality String?
  ward         String?
  street       String?
  postalCode   String?

  // NEW ONBOARDING FIELDS - Academic
  prevSchool        String?
  prevQualification String?
  prevClass         String?
  prevRoll          String?
  prevGpa           String?
  tcNumber          String?

  // NEW ONBOARDING FIELDS - Admission
  admissionDate     DateTime?
  academicYear      String?
  campus            String?
  section           String?
  rollNumber        String?
  house             String?
  medium            String?
  shift             String?
  transportRequired Boolean @default(false)
  hostelRequired    Boolean @default(false)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id])

  user         User?
  attendance   Attendance[]
  feePayments  FeePayment[]
  examResults  ExamResult[]
  enrollments Enrollment[]
  hostelAllocations HostelAllocation[]
  transportAssignments TransportAssignment[]
  invoices StudentInvoice[]

  @@unique([schoolId, studentId])
  @@index([schoolId])
}

// ─── Teacher ───────────────────────────────────────────────────────────────────

model Teacher {
  id         String   @id @default(uuid())
  employeeId String
  name       String
  department String
  phone      String
  status     String   @default("Active")

  title          String?
  about          String?
  address        String?
  qualifications String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  user              User?
  subjects          Subject[]
  classTeacher      Class[]            @relation("ClassTeacher")
  timetableSlots    Timetable[]
  assignments       Assignment[]
  teacherAttendance TeacherAttendance[]
  salaries          Salary[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

// ─── Staff (Non-Teaching) ──────────────────────────────────────────────────────

model Staff {
  id           String   @id @default(uuid())
  staffId      String
  name         String
  role         String             // Librarian, Security Guard, Janitor, etc.
  department   String
  phone        String?
  email        String?
  address      String?
  emergencyContact String?
  joiningDate  DateTime?
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, staffId])
  @@index([schoolId])
}

// ─── Parent ────────────────────────────────────────────────────────────────────

model Parent {
  id           String   @id @default(uuid())
  parentId     String
  name         String
  phone        String
  email        String?
  occupation   String?
  address      String?
  relationship String   @default("Father") // Father, Mother, Guardian
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  students Student[]

  @@unique([schoolId, parentId])
  @@index([schoolId])
}

// ─── Class ─────────────────────────────────────────────────────────────────────

model Class {
  id   String @id @default(uuid())
  name String
  room String

  classTeacherId String?
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  students       Student[]
  subjects       Subject[]
  timetableSlots Timetable[]
  attendance     Attendance[]
  assignments    Assignment[]
  fees           Fee[]
  examClasses    ExamClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
  @@index([schoolId])
}

// ─── Subject ───────────────────────────────────────────────────────────────────

model Subject {
  id   String @id @default(uuid())
  name String
  code String?

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  description String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  timetableSlots Timetable[]
  assignments    Assignment[]
  examResults    ExamResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, classId])
  @@index([schoolId])
}

// ─── Timetable ─────────────────────────────────────────────────────────────────

model Timetable {
  id        String @id @default(uuid())
  dayOfWeek String
  startTime String
  endTime   String

  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// ─── Attendance ────────────────────────────────────────────────────────────────

model Attendance {
  id     String   @id @default(uuid())
  date   DateTime
  status String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([schoolId])
}

model TeacherAttendance {
  id     String   @id @default(uuid())
  date   DateTime
  status String

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teacherId, date])
  @@index([schoolId])
}

// ─── Assignment ────────────────────────────────────────────────────────────────

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  status      String   @default("Active")

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// ─── Exam ──────────────────────────────────────────────────────────────────────

model Exam {
  id        String   @id @default(uuid())
  name      String
  type      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("Scheduled")

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  examClasses ExamClass[]
  results     ExamResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model ExamClass {
  id      String @id @default(uuid())
  examId  String
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([examId, classId])
}

model ExamResult {
  id         String @id @default(uuid())
  marks      Float
  maxMarks   Float  @default(100)
  grade      String?

  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([examId, studentId, subjectId])
}

// ─── Fee ───────────────────────────────────────────────────────────────────────

model Fee {
  id       String @id @default(uuid())
  name     String
  amount   Float
  currency String @default("usd")
  dueDate  DateTime

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  payments FeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model FeePayment {
  id       String   @id @default(uuid())
  amount   Float
  paidDate DateTime?
  status   String   @default("Pending")
  currency String   @default("usd")
  method   String   @default("Manual")
  stripePaymentIntentId String? @unique
  refundedAmountMinor Int @default(0)
  stripeRefundId String? @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeId     String
  fee       Fee     @relation(fields: [feeId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  attempts PaymentAttempt[]

  @@unique([studentId, feeId])
  @@index([schoolId])
}

// A durable attempt gives concurrent requests one Stripe idempotency key and
// preserves the school/account/amount snapshot independently of browser input.
model PaymentAttempt {
  id String @id @default(uuid())
  paymentId String
  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  activeKey String? @unique
  schoolId String
  studentId String
  feeId String
  provider String @default("Stripe")
  stripeAccountId String?
  providerSessionId String? @unique
  merchantRef String?
  checkoutPayload String?
  amountMinor Int
  currency String
  stripeSessionId String? @unique
  stripePaymentIntentId String? @unique
  checkoutUrl String?
  status String @default("Creating")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, studentId])
}

model StripeEvent {
  id String @id
  accountId String
  type String
  createdAt DateTime @default(now())
}

// ─── Notice ────────────────────────────────────────────────────────────────────

model Notice {
  id       String   @id @default(uuid())
  title    String
  content  String
  type     String   @default("General")
  audience String   @default("All")
  priority String   @default("Medium")
  date     DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// ─── Event ─────────────────────────────────────────────────────────────────────

model Event {
  id    String   @id @default(uuid())
  title String
  date  DateTime
  type  String   @default("event")

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// ─── Message ───────────────────────────────────────────────────────────────────

model Message {
  id      String   @id @default(uuid())
  content String
  read    Boolean  @default(false)

  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@index([schoolId])
}

// ─── Salary ────────────────────────────────────────────────────────────────────

model Salary {
  id        String   @id @default(uuid())
  month     String
  basic     Float
  allowances Float   @default(0)
  deductions Float   @default(0)
  netPay    Float
  status    String   @default("Pending")

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teacherId, month])
  @@index([schoolId])
}

// ─── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String           // e.g. "Created Student", "Deleted Notice"
  entity    String?          // e.g. "Student", "Notice"
  entityId  String?
  details   String?          // JSON string with extra context
  severity  String   @default("Info")  // Info, Warning, Critical
  ipAddress String?
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([createdAt])
}

// ─── Document ──────────────────────────────────────────────────────────────────

model Document {
  id          String   @id @default(uuid())
  name        String
  fileName    String           // Original filename
  fileSize    String?          // e.g. "2.4 MB"
  fileType    String?          // e.g. "pdf", "docx"
  category    String   @default("General") // Policy, Student Record, Finance, Template
  uploadedBy  String?
  url         String?          // File storage path/URL
  content     Bytes?
  sizeBytes   Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model SchoolSettings {
  timezone String @default("Asia/Kathmandu")
  province String @default("")
  district String @default("")
  municipality String @default("")
  ward String @default("")
  fiscalYear String @default("")
  schoolId String @id
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  registrationNumber String @default("")
  academicYear String @default("")
  termName String @default("")
  startDate DateTime?
  endDate DateTime?
  passingMarks Int @default(40)
  gradingScale String @default("A:90,B:80,C:70,D:60,E:40,F:0")
  updatedAt DateTime @updatedAt
}

model Plan {
  id String @id @default(uuid())
  name String @unique
  priceMinor Int @default(0)
  currency String @default("usd")
  interval String @default("Monthly")
  studentLimit Int @default(500)
  storageGb Int @default(10)
  features String @default("")
  active Boolean @default(true)
  subscriptions Subscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(uuid())
  schoolId String @unique
  school School @relation(fields: [schoolId], references: [id])
  planId String
  plan Plan @relation(fields: [planId], references: [id])
  status String @default("Active")
  startDate DateTime
  endDate DateTime
  payments SubscriptionPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, endDate])
}

model SubscriptionPayment {
  id String @id @default(uuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  amountMinor Int
  currency String @default("usd")
  reference String @unique
  paidDate DateTime
  note String @default("")
  createdAt DateTime @default(now())
}

// Validated, versioned editorial/configuration records, never account permissions.
model PlatformEntry {
  id String @id @default(uuid())
  kind String
  title String
  data String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([kind, createdAt])
}

model PlatformSetting {
  key String @id
  data String
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id String @id @default(uuid())
  schoolId String
  school School @relation(fields: [schoolId], references: [id])
  subject String
  description String
  priority String @default("Normal")
  status String @default("Open")
  response String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, status])
}

// ─── Notification ──────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   // e.g. "assignment", "notice", "message", "system"
  isRead    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([schoolId])
}

// ─── Password Reset Token ──────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Library ───────────────────────────────────────────────────────────────────

model Book {
  id          String   @id @default(uuid())
  bookId      String   // Unique book identifier e.g. "B001"
  title       String
  author      String
  category    String
  status      String   @default("Available")
  
  issuedTo    String?  // Can store studentId or name temporarily, or relate to User
  dueDate     DateTime?

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bookId, schoolId])
  @@index([schoolId])
}

// ─── Laboratory ────────────────────────────────────────────────────────────────

model LabItem {
  id          String   @id @default(uuid())
  itemId      String   // Unique item identifier
  name        String
  category    String
  quantity    Int      @default(0)
  status      String   @default("Good Condition")

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemId, schoolId])
  @@index([schoolId])
}

// ─── Health Records ────────────────────────────────────────────────────────────

model HealthRecord {
  id          String   @id @default(uuid())
  recordId    String
  studentName String   // Or link to Student model if preferred
  bloodGroup  String
  allergies   String?
  lastCheckup DateTime?
  notes       String?

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recordId, schoolId])
  @@index([schoolId])
}

// ─── Transport ─────────────────────────────────────────────────────────────────

model TransportRoute {
  id          String   @id @default(uuid())
  routeId     String
  name        String
  bus         String
  driver      String
  capacity    Int
  enrolled    Int      @default(0)
  fee         Float
  stops TransportStop[]
  assignments TransportAssignment[]

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([routeId, schoolId])
  @@index([schoolId])
}

// ─── Certificates ──────────────────────────────────────────────────────────────

model Certificate {
  id          String   @id @default(uuid())
  certId      String
  studentName String
  type        String
  date        DateTime?
  status      String   @default("Pending")

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([certId, schoolId])
  @@index([schoolId])
}

// ─── App Version ───────────────────────────────────────────────────────────────

model AppVersion {
  id           String   @id @default(uuid())
  version      String
  forceUpdate  Boolean  @default(false)
  downloadUrl  String
  releaseNotes String?
  createdAt    DateTime @default(now())
}

// Institution expansion. Existing School IDs remain the tenant boundary.
model Campus {
  id String @id @default(uuid())
  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name String
  code String
  address String @default("")
  departments Department[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, code])
  @@index([schoolId])
}
model Department {
  id String @id @default(uuid())
  schoolId String
  campusId String
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
  name String
  code String
  programs Program[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([campusId, code])
  @@index([schoolId])
}
model Program {
  id String @id @default(uuid())
  schoolId String
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name String
  code String
  level String @default("School")
  system String @default("Annual")
  duration Int @default(1)
  requiredCredits Int @default(0)
  affiliatingBody String @default("")
  enrollments Enrollment[]
  courses ProgramCourse[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, code])
  @@index([schoolId])
}
model AcademicTerm {
  id String @id @default(uuid())
  schoolId String
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name String
  academicYear String
  startDate DateTime
  endDate DateTime
  enrollments Enrollment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, academicYear, name])
  @@index([schoolId])
}
model ProgramCourse {
  id String @id @default(uuid())
  schoolId String
  programId String
