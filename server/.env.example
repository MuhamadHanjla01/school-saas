DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate two independent values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
# Set only when behind a trusted reverse proxy.
# TRUST_PROXY_HOPS=1
# SMTP is optional locally. Recovery explicitly reports unavailable when absent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=ERPZO <support@example.com>
# Stripe is optional. Never put private keys in VITE_ variables.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
